{
  "package": "monitoringsuiteapi",
  "resource": "MonitoringSuitePublisher",
  "command_prefix": "Publisher",
  "imports": {
    "v1": "github.com/sacloud/sacloud-sdk-go/api/monitoring-suite/apis/v1"
  },
  "operations": [
    {
      "name": "List",
      "help": "Publisher を一覧表示します。Publisher はモニタリングスイートにデータを転送する送信元の種類です。",
      "method": "List",
      "response_type": "[]v1.Publisher",
      "arguments": [
        {
          "name": "count",
          "field": "Count",
          "type": "*int",
          "flag": true,
          "help": "任意: 1 回の取得件数。"
        },
        {
          "name": "from",
          "field": "From",
          "type": "*int",
          "flag": true,
          "help": "任意: 取得開始位置 (0 開始)。"
        }
      ],
      "command_name": "list-publishers"
    },
    {
      "name": "Read",
      "help": "Publisher コードを指定して Publisher を読み取ります。",
      "method": "Read",
      "response_type": "*v1.Publisher",
      "arguments": [
        {
          "name": "code",
          "field": "Code",
          "type": "string",
          "help": "読み取る Publisher のコード。list-publishers の出力にある Code。"
        }
      ],
      "command_name": "read-publisher"
    }
  ],
  "wiring_target": "MonitoringSuiteAPI.Publisher",
  "sdk_factory": "monitoringsuiteapi.NewPublisherAPI"
}
