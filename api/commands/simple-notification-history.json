{
  "package": "simplenotificationapi",
  "resource": "Simple Notification history",
  "command_type": "HistoryCommands",
  "api_type": "HistoryAPI",
  "factory_type": "HistoryAPIFactory",
  "runtime_type": "HistoryRuntime",
  "imports": {
    "v1": "github.com/sacloud/sacloud-sdk-go/api/simple-notification/apis/v1"
  },
  "operations": [
    {
      "name": "List",
      "command_type": "HistoryListCommand",
      "help": "通知履歴を一覧表示します。",
      "method": "List",
      "response_type": "*v1.ListSimpleNotificationHistoriesResponse"
    },
    {
      "name": "Read",
      "command_type": "HistoryReadCommand",
      "help": "通知履歴を読み取ります。",
      "method": "Read",
      "arguments": [
        {
          "name": "id",
          "field": "ID",
          "type": "string",
          "help": "参照する通知履歴 ID。"
        }
      ],
      "response_type": "*v1.GetSimpleNotificationHistoryResponse"
    }
  ]
}
