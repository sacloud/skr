{
  "package": "iamapi",
  "resource": "SCIM configuration",
  "command_prefix": "Scim",
  "imports": {
    "scim": "github.com/sacloud/sacloud-sdk-go/api/iam/apis/scim",
    "v1": "github.com/sacloud/sacloud-sdk-go/api/iam/apis/v1"
  },
  "operations": [
    {
      "name": "List",
      "help": "ユーザープロビジョニング設定を一覧表示します。",
      "method": "List",
      "request_type": "scim.ListParams",
      "request_by_value": true,
      "request_optional": true,
      "response_type": "*v1.ListScimConfigurationsOK",
      "flags": [
        {
          "name": "page",
          "field": "Page",
          "type": "int",
          "help": "任意: 取得するページ番号。",
          "pointer": true
        },
        {
          "name": "per-page",
          "field": "PerPage",
          "type": "int",
          "help": "任意: 1 ページあたりの取得件数。",
          "pointer": true
        }
      ],
      "command_name": "list-scim-configurations",
      "no_request_flag": true
    },
    {
      "name": "Create",
      "help": "ユーザープロビジョニング設定を作成します。",
      "method": "Create",
      "request_type": "scim.CreateParams",
      "request_by_value": true,
      "request_help": "ユーザープロビジョニング設定の JSON。name を指定し、直接または @path.json で読み込みます。",
      "response_type": "*v1.ScimConfiguration",
      "flags": [
        {
          "name": "name",
          "field": "Name",
          "type": "string",
          "help": "必須: 設定名。",
          "required": true
        }
      ],
      "command_name": "create-scim-configuration"
    },
    {
      "name": "Read",
      "help": "ID を指定してユーザープロビジョニング設定を読み取ります。",
      "method": "Read",
      "response_type": "*v1.ScimConfigurationBase",
      "arguments": [
        {
          "name": "id",
          "field": "ID",
          "type": "string",
          "help": "読み取る設定 ID。"
        }
      ],
      "command_name": "read-scim-configuration"
    },
    {
      "name": "Update",
      "help": "ユーザープロビジョニング設定を更新します。更新後の設定名を --name または --request JSON の name に指定してください。",
      "method": "Update",
      "request_type": "scim.UpdateParams",
      "request_by_value": true,
      "request_help": "更新後の設定名を含む JSON。name は必須です。直接指定するか @path.json で読み込みます。--request と --name は併用できません。",
      "response_type": "*v1.ScimConfigurationBase",
      "arguments": [
        {
          "name": "id",
          "field": "ID",
          "type": "string",
          "help": "更新する設定 ID。"
        }
      ],
      "flags": [
        {
          "name": "name",
          "field": "Name",
          "type": "string",
          "help": "必須: 更新後の設定名。",
          "required": true
        }
      ],
      "command_name": "update-scim-configuration"
    },
    {
      "name": "Delete",
      "help": "ID を指定してユーザープロビジョニング設定を削除します。プロビジョニングされたユーザーとグループをすべて削除してから実行してください。",
      "method": "Delete",
      "arguments": [
        {
          "name": "id",
          "field": "ID",
          "type": "string",
          "help": "削除する設定 ID。"
        }
      ],
      "command_name": "delete-scim-configuration"
    },
    {
      "name": "RegenerateToken",
      "help": "ユーザープロビジョニング設定の秘密トークンを再発行します。再発行後は古いトークンが使えなくなるため、連携先を更新できる場合にのみ実行してください。",
      "method": "RegenerateToken",
      "response_type": "*v1.RegenerateScimConfigurationTokenOK",
      "arguments": [
        {
          "name": "id",
          "field": "ID",
          "type": "string",
          "help": "トークンを再発行する設定 ID。"
        }
      ],
      "command_name": "regenerate-scim-configuration-token"
    }
  ],
  "wiring_target": "IAMAPI.SCIM",
  "sdk_factory": "iamapi.NewSCIMAPI",
  "decoder": "iamapi.DecodeRequest"
}
